{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaiatlas.dev/schema/research/feed-item.schema.json",
  "title": "feed-item",
  "unevaluatedProperties": false,
  "allOf": [
    { "$ref": "_shared.schema.json#/$defs/base" },
    { "$ref": "_shared.schema.json#/$defs/feed_item" }
  ],
  "properties": {
    "type": { "const": "feed-item" },
    "schema_version": { "const": 2.0 },
    "kind": { "const": "paper", "description": "this repository holds papers only; news and newsletter issues live in atlas-news-content" },
    "source_tool": { "enum": ["arxiv", "huggingface-papers"] }
  },
  "required": ["kind"]
}
