{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaiatlas.dev/schema/research/_shared.schema.json",
  "title": "Shared definitions for atlas-research-content",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "lowercase, hyphen-separated, ASCII"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "stable identity of the form <type>/<slug>"
    },
    "source": {
      "type": "object",
      "required": ["url", "title"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "trust": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "base": {
      "type": "object",
      "required": ["id", "type", "slug", "schema_version", "title", "tags", "updated", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "type": "string",
          "enum": ["paper", "research-topic", "research-direction", "research-resource"]
        },
        "slug": { "$ref": "#/$defs/slug" },
        "schema_version": { "type": ["string", "number"] },
        "title": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "other names the record is written as"
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "related": { "type": "array", "items": { "type": "string" } },
        "locked": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "field paths (for example `summary`, `must_read.era`) no job may change; a human edits them"
        }
      }
    }
  }
}
