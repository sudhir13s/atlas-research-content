{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaiatlas.dev/schema/research/research-resource.schema.json",
  "title": "research-resource",
  "allOf": [{ "$ref": "_shared.schema.json#/$defs/base" }],
  "properties": {
    "type": { "const": "research-resource" },
    "icon": { "type": "string", "minLength": 1, "description": "an emoji shown beside the platform" },
    "links": {
      "type": "array",
      "minItems": 1,
      "description": "useful pages of the platform, in display order",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "order": { "type": "integer", "minimum": 1, "description": "position among the resources, 1 = first" }
  },
  "required": ["icon", "links", "order"]
}
